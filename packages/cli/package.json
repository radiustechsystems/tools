{
  "name": "radius-cli",
  "version": "0.5.0",
  "description": "CLI wallet for the Radius network \u2014 like cast, with a built-in account",
  "type": "module",
  "bin": {
    "radius-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b . && chmod +x dist/index.js",
    "dev": "tsc -p . --watch",
    "test": "vitest run",
    "typecheck": "tsc -b .",
    "prepublishOnly": "node scripts/prepublish.mjs && pnpm run build"
  },
  "keywords": [
    "radius",
    "radiustech",
    "ethereum",
    "evm",
    "cli",
    "wallet",
    "cast",
    "rusd",
    "sbc"
  ],
  "author": "Anders Brownworth <anders@radiustechnologysystems.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radiustechsystems/tools.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/radiustechsystems/tools#readme",
  "bugs": {
    "url": "https://github.com/radiustechsystems/tools/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "commander": "^12.1.0",
    "ethers": "^6.13.0",
    "radius-sdk": "workspace:^",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
