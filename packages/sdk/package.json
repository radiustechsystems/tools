{
  "name": "radius-sdk",
  "version": "0.7.0",
  "description": "Accept and make Radius payments over x402 v2 — any web-standard runtime, Hono, or the upstream x402 framework adapters",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm run test:imports",
    "test:e2e": "RADIUS_E2E=1 vitest run test/e2e",
    "test:mpp": "vitest run test/mpp-wire.test.ts test/mpp.test.ts",
    "prepublishOnly": "pnpm run build",
    "test:imports": "pnpm run build && node --test scripts/imports.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "hono": "^4.0.0",
    "viem": "^2.48.11"
  },
  "peerDependenciesMeta": {
    "@x402/evm": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/statemanager": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@hono/node-server": "^2.1.5",
    "@types/express": "^5.0.6",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/express": "2.27.0",
    "express": "^5.2.1",
    "hono": "^4.13.7",
    "mppx": "0.13.4",
    "typescript": "^5.9.0",
    "viem": "^2.48.11",
    "vitest": "^3.2.0",
    "wrangler": "^4.131.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radiustechsystems/tools.git",
    "directory": "packages/sdk"
  }
}
