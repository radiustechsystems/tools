// Cloudflare Worker for docs.radiustech.xyz: Workers static assets serve the built site from
// dist/public (including public/_redirects and public/_headers); worker/index.ts handles /api/try/*, and
// serves pages and agent files so it can record agent requests (see run_worker_first).
// Deployed by .github/workflows/docs-deploy.yml, never from a laptop.
// Ref: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "radius-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  // docs.radiustech.xyz shares a zone with testnet.radiustech.xyz and facilitator.testnet.radiustech.xyz. Without
  // this flag, fetch() to a same-zone host goes straight to its origin and bypasses what serves it there, so
  // the faucet proxy got an empty 404. With it, subrequests take the public route like any client's.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    // /api/try/* is the Worker's own API. Every other path reaches the Worker too, except scripts, styles and
    // images: worker/index.ts serves pages and agent files from static assets, gives a page's Markdown twin to
    // requests that prefer Markdown, and records agent requests, because browser analytics never see agents.
    // Exclusions win over "/*"; keep them in step with what dist/public contains.
    "run_worker_first": ["/*", "!/assets/*", "!/RSC/*", "!/imgs/*", "!/og/*", "!/*.svg", "!/*.png", "!/favicon.ico"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // The workers.dev URL, and Version URLs for `wrangler versions upload`. Cloudflare generates no Version URL for a
  // Worker that implements a Durable Object, so PR previews are Worker Previews: see "previews" below.
  "workers_dev": true,
  "preview_urls": true,
  // Recipient of the testnet payments made from the interactive "Try Radius" components: the testnet
  // faucet's payout wallet, so test SBC goes back to the faucet. Testnet only; no private key on the server.
  // RADIUS_PROJECT_ID: the Radius Platform project ("docs.radiustech.xyz") whose policy gates agent requests
  // (worker/index.ts). The RADIUS_API_KEY secret, an organization key with endpoints:read, lets the cron sync it:
  // set it with `wrangler secret put RADIUS_API_KEY`. Without it, nothing is gated.
  "vars": {
    "TRY_PAY_TO": "0x0fD9Ba4a476C7f544cC9b04e54D6B7bb53F2f568",
    "RADIUS_PROJECT_ID": "01a19d11-7c95-74ac-af09-3d8037ae7625",
  },
  // The compiled policy, written by the sync and read on every agent request.
  // TODO: replace with the id of a namespace created in the Radius account (`wrangler kv namespace create
  // radius-docs-RADIUS_POLICY`) before this merges.
  "kv_namespaces": [{ "binding": "RADIUS_POLICY", "id": "9f366bad84104aea97407a8959880653" }],
  // Exact counts for the policy's free quotas and rate limits, and payment claims. A new Durable Object class
  // needs a migration: production applies it with `wrangler deploy`, and `wrangler preview` applies it to each
  // Preview's own namespace.
  "durable_objects": { "bindings": [{ "name": "RADIUS_LIMITER", "class_name": "RadiusCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RadiusCounter"] }],
  // Syncs the policy every minute, so a change on the platform applies within about two minutes.
  "triggers": { "crons": ["* * * * *"] },
  // One data point per agent request, and per sampled or agent-like browser page load (worker/index.ts documents
  // the columns). Query them with the Analytics Engine SQL API (`SELECT ... FROM docs_agent_fetches`,
  // `docs_browser_signals`) and an Account Analytics: Read token.
  "analytics_engine_datasets": [
    { "binding": "AGENT_FETCHES", "dataset": "docs_agent_fetches" },
    { "binding": "BROWSER_SIGNALS", "dataset": "docs_browser_signals" },
  ],
  // No "routes": the docs.radiustech.xyz custom domain is attached in the Cloudflare dashboard. `wrangler deploy`
  // calls the custom-domains API only for custom_domain routes listed here, so it leaves that domain alone and
  // the CI token needs no zone or DNS permissions. Don't add the domain back here without granting those.
  // Workers Logs: one invocation log per request that reaches the Worker, plus the "agent fetch" line from
  // worker/index.ts. Query them under Workers & Pages > radius-docs > Observability.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  // Per-PR Previews (`wrangler preview --name pr-<number>` in .github/workflows/docs.yml). A Preview inherits none
  // of the settings above except assets, compatibility settings and the Durable Object classes and migrations,
  // so this block repeats every binding worker/index.ts reads. Each Preview gets its own RadiusCounter namespace
  // and storage, deleted with the Preview. Cron Triggers don't run on Previews, so nothing syncs the policy here:
  // a Preview only reads RADIUS_POLICY, so it shares the production namespace and enforces the live policy.
  // Agent data points land in the production dataset; filter Previews out by host.
  // Ref: https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    "vars": {
      "TRY_PAY_TO": "0x0fD9Ba4a476C7f544cC9b04e54D6B7bb53F2f568",
      "RADIUS_PROJECT_ID": "01a19d11-7c95-74ac-af09-3d8037ae7625",
    },
    "kv_namespaces": [{ "binding": "RADIUS_POLICY", "id": "9f366bad84104aea97407a8959880653" }],
    "durable_objects": { "bindings": [{ "name": "RADIUS_LIMITER", "class_name": "RadiusCounter" }] },
    "analytics_engine_datasets": [
      { "binding": "AGENT_FETCHES", "dataset": "docs_agent_fetches" },
      { "binding": "BROWSER_SIGNALS", "dataset": "docs_browser_signals" },
    ],
    "observability": {
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "head_sampling_rate": 1,
      },
    },
  },
}
