// Cloudflare Worker for docs.radiustech.xyz: Workers static assets serve the built site from
// dist/public (including public/_redirects and public/_headers); worker/index.ts handles /api/try/*, and
// serves pages and agent files so it can record agent requests (see run_worker_first).
// Deployed by .github/workflows/docs-deploy.yml, never from a laptop.
// Ref: https://developers.cloudflare.com/workers/static-assets/
{
  "name": "radius-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  // docs.radiustech.xyz shares a zone with testnet.radiustech.xyz and facilitator.testnet.radiustech.xyz. Without
  // this flag, fetch() to a same-zone host goes straight to its origin and bypasses what serves it there, so
  // the faucet proxy got an empty 404. With it, subrequests take the public route like any client's.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    // /api/try/* is the Worker's own API. Every other path reaches the Worker too, except scripts, styles and
    // images: worker/index.ts serves pages and agent files from static assets, gives a page's Markdown twin to
    // requests that prefer Markdown, and records agent requests, because browser analytics never see agents.
    // Exclusions win over "/*"; keep them in step with what dist/public contains.
    "run_worker_first": ["/*", "!/assets/*", "!/RSC/*", "!/imgs/*", "!/og/*", "!/*.svg", "!/*.png", "!/favicon.ico"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Per-PR preview URLs come from `wrangler versions upload --preview-alias`.
  "workers_dev": true,
  "preview_urls": true,
  // Recipient of the testnet payments made from the interactive "Try Radius" components: the testnet
  // faucet's payout wallet, so test SBC goes back to the faucet. Testnet only; no private key on the server.
  "vars": {
    "TRY_PAY_TO": "0x0fD9Ba4a476C7f544cC9b04e54D6B7bb53F2f568",
  },
  // One data point per agent request (worker/index.ts documents the columns). Query it with the
  // Analytics Engine SQL API (`SELECT ... FROM docs_agent_fetches`) and an Account Analytics: Read token.
  "analytics_engine_datasets": [{ "binding": "AGENT_FETCHES", "dataset": "docs_agent_fetches" }],
  // No "routes": the docs.radiustech.xyz custom domain is attached in the Cloudflare dashboard. `wrangler deploy`
  // calls the custom-domains API only for custom_domain routes listed here, so it leaves that domain alone and
  // the CI token needs no zone or DNS permissions. Don't add the domain back here without granting those.
  // Workers Logs: one invocation log per request that reaches the Worker, plus the "agent fetch" line from
  // worker/index.ts. Query them under Workers & Pages > radius-docs > Observability.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
}
