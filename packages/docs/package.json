{
  "name": "radius-docs",
  "private": true,
  "description": "Radius developer documentation (docs.radiustech.xyz)",
  "type": "module",
  "scripts": {
    "generate-skills": "tsx scripts/generate-skills-md.ts",
    "test:skills": "node --import tsx --test scripts/generate-skills-md.test.ts",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "generate-release-notes": "tsx scripts/generate-release-notes.ts",
    "test:release-notes": "node --import tsx --test scripts/generate-release-notes.test.ts",
    "fetch-cost": "tsx scripts/fetch-transaction-cost.ts",
    "predev": "tsx scripts/generate-release-notes.ts",
    "dev": "vocs dev",
    "prebuild": "tsx scripts/generate-skills-md.ts && tsx scripts/generate-release-notes.ts && tsx scripts/generate-sitemap.ts",
    "build": "vocs build",
    "preview": "vocs preview",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "docs:validate": "tsx scripts/generate-release-notes.ts && tsx scripts/validate-docs-v2.ts",
    "postbuild": "tsx scripts/postbuild-static-markdown.ts",
    "docs:markdown-audit": "tsx scripts/generate-release-notes.ts && vocs markdown-audit",
    "docs:agent-check": "tsx scripts/validate-agent-markdown.ts",
    "docs:sitemap-check": "tsx scripts/validate-sitemap.ts",
    "typecheck:docs": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "hono": "^4.13.7",
    "lucide-react": "^0.576.0",
    "radius-sdk": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "~19.3.0",
    "viem": "^2.48.11",
    "vocs": "^2.10.0",
    "waku": "1.0.0-rc.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.3",
    "mdast-util-mdx-expression": "^2.0.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "prettier": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.147.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=9"
  }
}
